{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omegle-signaling-cloudflare",
  "main": "src/index.js",
  "compatibility_date": "2026-11-10",
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MATCHMAKER",
        "class_name": "Matchmaker"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Matchmaker"]
    }
  ],
  "vars": {
    "SUPABASE_URL": "https://btkcubibosbtpxcronnd.supabase.co"
  }
}
