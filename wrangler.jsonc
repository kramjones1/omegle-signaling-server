{
  // Trigger fresh Cloudflare build after correcting the required-secret config.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omegle-signaling-server",
  "main": "src/index.js",
  "compatibility_date": "2026-11-10",
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MATCHMAKER",
        "class_name": "Matchmaker"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Matchmaker"
      ]
    }
  ],
  "vars": {
